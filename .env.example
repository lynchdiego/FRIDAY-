# FRIDAY — configuración. Copia este archivo como .env y llena los valores.
# .env NUNCA se sube a GitHub (está en .gitignore).

# Contraseña para entrar a la app (mínimo 8 caracteres; usa una larga y única)
FRIDAY_PASSWORD=

# Llave de cifrado para los tokens de Google (32 bytes en base64). Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Claude (platform.claude.com). Si la dejas vacía, FRIDAY usa un Claude simulado (gratis).
ANTHROPIC_API_KEY=
MODEL_DEFAULT=claude-sonnet-5-5
MODEL_HEAVY=claude-opus-5-5

# Límite de gasto diario en Claude (USD). Al alcanzarlo, FRIDAY pasa a modo básico.
DAILY_LIMIT_USD=2

# Base de datos. Vacío = PostgreSQL local en archivo (PGlite), ideal para desarrollo.
# En producción: postgres://usuario:clave@host:5432/friday
DATABASE_URL=

# Zona horaria y nombre del dueño
FRIDAY_TZ=America/Cancun
OWNER_NAME=Diego

# Integraciones: mock (datos ficticios) | google (Calendar, Gmail, Tasks reales)
INTEGRATIONS=mock
# Google Cloud → Google Auth Platform → Clientes (ver docs/google-setup.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dirección desde la que abres FRIDAY (en tu Mac: http://localhost:5173)
PUBLIC_URL=http://localhost:5173

# Voz (ElevenLabs). Si la dejas vacía, FRIDAY usa la voz y el reconocimiento del navegador (gratis).
ELEVENLABS_API_KEY=
# ID de la voz ORIGINAL que crees con Voice Design (ver docs/etapa-5.md). No clonar voces de nadie.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2
# Precios estimados para el registro de costos (confirmar en elevenlabs.io/pricing)
VOICE_TTS_USD_PER_1K_CHARS=0.05
VOICE_STT_USD_PER_HOUR=0.22

# Segundos que dura una confirmación pendiente
ACTION_TTL_SECONDS=300
PORT=8787
